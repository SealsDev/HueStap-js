{
  "name": "huestep",
  "version": "1.0.0",
  "description": "RGB colors and text gradients for the Node.js terminal.",
  "type": "module",
  "main": "./src/index.cjs",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.cjs",
